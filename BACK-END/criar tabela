-- Tabela de Clientes
CREATE TABLE IF NOT EXISTS clientes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome TEXT NOT NULL,
    cpf TEXT NOT NULL UNIque,
    data_nasc text,
    telefone integer ,
    email TEXT,
    cep integer,
    endereco TEXT NOT NULL,
    numero_casa text,
    complemento text,
    bairro text,
    cidade text,
    estado text,
    data_cadastro TEXT DEFAULT CURRENT_TIMESTAMP
);

-- Tabela Fornecedor
CREATE TABLE IF NOT EXISTS fornecedor (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    razao_social text not null,
    cnpj TEXT NOT NULL unique,
    nome TEXT NOT NULL,
    inscricao_estadu text,
    endereco TEXT NOT NULL,
    prod_fornecido TEXT NOT NULL,
    email TEXT NOT NULL,
    telefone integer ,
    cep integer,
    numero_casa text,
    complemento text,
    bairro text,
    cidade text,
    estado text,
    data_cadastro TEXT DEFAULT CURRENT_TIMESTAMP
);

-- Tabela de Produtos
CREATE TABLE IF NOT EXISTS produtos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
  	codigo_produto TEXT NOT NULL,
    nome_produto TEXT NOT NULL,
  	categoria TEXT,
    fornecedor TEXT,
  	descricao TEXT,
    preco_unit REAL NOT NULL CHECK(preco_unit >= 0),
  	quantidade INTEGER CHECK(quantidade >= 0),
  	unidade_medida TEXT,
  	data_validade TEXT
);

-- Tabela de Pedidos
CREATE TABLE IF NOT EXISTS pedidos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    cliente_id INTEGER NOT NULL,
  	numero_pedido TEXT NOT NULL,
  	numero_mesa INTEGER NOT NULL,
  	nome_cliente TEXT NOT NULL,
    data TEXT DEFAULT CURRENT_TIMESTAMP,
  	hora TEXT nOT NULL,
    FOREIGN KEY (cliente_id) REFERENCES clientes(id) ON DELETE CASCADE
);

-- Tabela de Itens do Pedido
CREATE TABLE IF NOT EXISTS itens_pedido (
    pedido_id INTEGER NOT NULL,
    produto_id INTEGER NOT NULL,
    quantidade INTEGER NOT NULL CHECK(quantidade > 0),
    preco_unitario REAL NOT NULL CHECK(preco_unitario >= 0),
    PRIMARY KEY (pedido_id, produto_id),
    FOREIGN KEY (pedido_id) REFERENCES pedidos(id) ON DELETE CASCADE,
    FOREIGN KEY (produto_id) REFERENCES produtos(id)
);

-- Tabela de Produtos Fornecidos
CREATE TABLE IF NOT EXISTS prod_fornecido (
    fornecedor_id INTEGER NOT NULL,
    produto_id INTEGER NOT NULL,
    quantidade INTEGER NOT NULL CHECK(quantidade > 0),
  	modelo TEXT not NULL,
    preco_unitario REAL NOT NULL CHECK(preco_unitario >= 0),
    PRIMARY KEY (fornecedor_id, produto_id),
    FOREIGN KEY (fornecedor_id) REFERENCES fornecedor(id) ON DELETE CASCADE,
    FOREIGN KEY (produto_id) REFERENCES produtos(id)
);

-- Tabela de Comanda
CREATE TABLE IF NOT EXISTS comanda (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    cliente_id INTEGER NOT NULL,
    status_pagamento TEXT NOT NULL,
    horario TEXT DEFAULT CURRENT_TIMESTAMP,
    subtotal REAL NOT NULL DEFAULT 0.0 CHECK(subtotal >= 0),
    FOREIGN KEY (cliente_id) REFERENCES clientes(id) ON DELETE CASCADE
);

-- Tabela de Itens da Comanda11
CREATE TABLE IF NOT EXISTS itens_comanda (
    comanda_id INTEGER NOT NULL,
    produto_id INTEGER NOT NULL,
    quantidade INTEGER NOT NULL CHECK(quantidade > 0),
    preco_unitario REAL NOT NULL CHECK(preco_unitario >= 0),
    PRIMARY KEY (comanda_id, produto_id),
    FOREIGN KEY (comanda_id) REFERENCES comanda(id) ON DELETE CASCADE,
    FOREIGN KEY (produto_id) REFERENCES produtos(id)
);

-- Tabela de Caixa
CREATE TABLE IF NOT EXISTS caixa (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    com_id INTEGER NOT NULL,
    forma_pagamento TEXT NOT NULL,
    horario TEXT DEFAULT CURRENT_TIMESTAMP,
    montante REAL NOT NULL DEFAULT 0.0 CHECK(montante >= 0),
  	quantidadeVendas REAL NOT NULL,
    FOREIGN KEY (com_id) REFERENCES comanda(id) ON DELETE CASCADE
);
